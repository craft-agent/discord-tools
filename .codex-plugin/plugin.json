{
  "name": "discord-tools",
  "version": "1.1.0",
  "description": "Discord tools for coding agents: chats, messages, search, inbox, files, sends and roles.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/discord-tools#readme",
  "repository": "https://github.com/craft-agent/discord-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "discord-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "DISCORD_TOOLS_TOOLSETS",
        "DISCORD_TOOLS_READ_ONLY",
        "DISCORD_TOOLS_TOOLS",
        "DISCORD_TOOLS_EXCLUDE_TOOLS",
        "DISCORD_TOOLS_CONFIRM",
        "DISCORD_TOOLS_UNATTENDED",
        "DISCORD_TOOLS_GRANTS_DIR",
        "DISCORD_TOOLS_STATE_DIR",
        "DISCORD_TOOLS_DOWNLOAD_DIR",
        "DISCORD_TOOLS_DOWNLOAD_MAX_MB",
        "DISCORD_TOOLS_SEND_DIRS",
        "DISCORD_TOOLS_SEND_MAX_MB",
        "DISCORD_TOOLS_GRANT_KEY"
      ]
    }
  }
}
